class HashTable:
 def __init__(self,size=5):
  self.size=size
  self.table=[None]*size
  self.count=0
 def insert(self,key):
  if self.count>=self.size*0.7:
   self.rehash()
  index=key%self.size
  while self.table[index] is not None:
   index=(index+1)%self.size
  self.table[index]=key
  self.count+=1
 def rehash(self):
  old=self.table
  self.size*=2
  self.table=[None]*self.size
  self.count=0
  for key in old:
   if key is not None:
    self.insert(key)
 def display(self):
  print(self.table)
h=HashTable()
for key in [10,15,20,7]:
 h.insert(key)
h.display()
