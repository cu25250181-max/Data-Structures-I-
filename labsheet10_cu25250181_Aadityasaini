def prim(graph):
    n = len(graph)
    selected = [False] * n
    selected[0] = True
    mst = []
    cost = 0

    for _ in range(n - 1):
        minimum = float('inf')
        x = y = -1

        for i in range(n):
            if selected[i]:
                for j in range(n):
                    if not selected[j] and graph[i][j] != 0:
                        if graph[i][j] < minimum:
                            minimum = graph[i][j]
                            x, y = i, j

        selected[y] = True
        mst.append((x, y, minimum))
        cost += minimum

    print("Edges in MST:")
    for edge in mst:
        print(edge)

    print("Minimum cost:", cost)


