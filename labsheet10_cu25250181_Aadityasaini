def kruskal(vertices, edges):
    parent = list(range(vertices))

    def find(x):
        while parent[x] != x:
            x = parent[x]
        return x

    mst = []
    cost = 0
    edges.sort(key=lambda x: x[2])

    for u, v, w in edges:
        pu = find(u)
        pv = find(v)

        if pu != pv:
            parent[pu] = pv
            mst.append((u, v, w))
            cost += w

    print("Edges in MST:")
    for edge in mst:
        print(edge)

    print("Minimum Cost:", cost)


edges = [
    (0, 1, 10),
    (0, 2, 6),
    (0, 3, 5),
    (1, 3, 15),
    (2, 3, 4)
]

kruskal(4, edges)
