from collections import deque

graph = {
 0:[1,2],
 1:[0,3,4],
 2:[0,4],
 3:[1],
 4:[1,2]
}
n=5
matrix=[[0]*n for _ in range(n)]
for i in graph:
 for j in graph[i]:
  matrix[i][j]=1
print("Adjacency Matrix:")
for row in matrix:
 print(row)
print("\nAdjacency List:")
for i in graph:
 print(i,":",graph[i])
def dfs(start):
 visited=[False]*n
 result=[]
 stack=[start]
 while stack:
  node=stack.pop()
  if not visited[node]:
   visited[node]=True
   result.append(node)
   for x in reversed(graph[node]):
    if not visited[x]:
     stack.append(x)

 return result

def bfs(start):
 visited=[False]*n
 result=[]
 queue=deque([start])
 visited[start]=True

 while queue:
  node=queue.popleft()
  result.append(node)

  for x in graph[node]:
   if not visited[x]:
    visited[x]=True
    queue.append(x)

 return result

print("\nDFS:",dfs(0))
print("BFS:",bfs(0))
#Q3class Graph:
 def __init__(self,n):
  self.n=n
  self.edges=[]

 def add_edge(self,u,v,w):
  self.edges.append((w,u,v))

 def kruskal(self):
  self.edges.sort()
  parent=list(range(self.n))
  result=[]
  cost=0

  def find(x):
   while parent[x]!=x:
    x=parent[x]
   return x

  for w,u,v in self.edges:
   a=find(u)
   b=find(v)

   if a!=b:
    result.append((u,v,w))
    cost+=w
    parent[a]=b

  print("Kruskal MST:")
  for u,v,w in result:
   print(u,"-",v,"=",w)
  print("Minimum Cost:",cost)

 def prim(self):
  selected=[False]*self.n
  selected[0]=True
  result=[]
  cost=0

  for _ in range(self.n-1):
   minimum=999999
   x=y=-1

   for u in range(self.n):
    if selected[u]:
     for v in range(self.n):
      if not selected[v] and matrix[u][v]!=0:
       if matrix[u][v]<minimum:
        minimum=matrix[u][v]
        x=u
        y=v

   selected[y]=True
   result.append((x,y,minimum))
   cost+=minimum

  print("\nPrim MST:")
  for u,v,w in result:
   print(u,"-",v,"=",w)
  print("Minimum Cost:",cost)

