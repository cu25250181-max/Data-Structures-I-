from collections import deque

graph = {
 0:[1,2],
 1:[0,3,4],
 2:[0,4],
 3:[1],
 4:[1,2]
}

n=5

matrix=[[0]*n for _ in range(n)]

for i in graph:
 for j in graph[i]:
  matrix[i][j]=1

print("Adjacency Matrix:")
for row in matrix:
 print(row)

print("\nAdjacency List:")
for i in graph:
 print(i,":",graph[i])

def dfs(start):
 visited=[False]*n
 result=[]
 stack=[start]

 while stack:
  node=stack.pop()
  if not visited[node]:
   visited[node]=True
   result.append(node)
   for x in reversed(graph[node]):
    if not visited[x]:
     stack.append(x)

 return result

def bfs(start):
 visited=[False]*n
 result=[]
 queue=deque([start])
 visited[start]=True

 while queue:
  node=queue.popleft()
  result.append(node)

  for x in graph[node]:
   if not visited[x]:
    visited[x]=True
    queue.append(x)

 return result

print("\nDFS:",dfs(0))
print("BFS:",bfs(0))
