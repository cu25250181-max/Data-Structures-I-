#open hasing
class Node:
 def __init__(self,data):
  self.data=data
  self.next=None

class OpenHash:
 def __init__(self,size):
  self.size=size
  self.table=[None]*size

 def insert(self,data):
  index=data%self.size
  new=Node(data)
  new.next=self.table[index]
  self.table[index]=new

 def display(self):
  for i in range(self.size):
   print(i,end=": ")
   temp=self.table[i]
   while temp:
    print(temp.data,end=" -> ")
    temp=temp.next
   print("None")

h=OpenHash(5)

values=[10,15,20,25,30]

for x in values:
 h.insert(x)

print("Open Hashing:")
h.display()

#close hasingclass ClosedHash:
 def __init__(self,size):
  self.size=size
  self.table=[None]*size
  self.count=0

 def insert(self,data):
  if self.count>=self.size*0.7:
   self.rehash()

  index=data%self.size

  while self.table[index] is not None:
   index=(index+1)%self.size

  self.table[index]=data
  self.count+=1

 def rehash(self):
  old=self.table
  self.size=self.size*2
  self.table=[None]*self.size
  self.count=0

  for x in old:
   if x is not None:
    self.insert(x)

 def display(self):
  for i in range(self.size):
   print(i,":",self.table[i])

h=ClosedHash(5)

values=[10,15,20,25,30]

for x in values:
 h.insert(x)

print("Closed Hashing:")
h.display()
