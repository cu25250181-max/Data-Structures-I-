class Node:
 def __init__(self,data):
  self.data=data
  self.prev=None
  self.next=None
class DLL:
 def __init__(self):
  self.head=None
  self.tail=None
 def insert(self,data):
  n=Node(data)
  if not self.head:
   self.head=self.tail=n
  else:
   self.tail.next=n
   n.prev=self.tail
   self.tail=n
 def delete(self,key):
  t=self.head
  while t and t.data!=key:
   t=t.next
  if not t:
   print("Element not found")
   return
  if t.prev:
   t.prev.next=t.next
  else:
   self.head=t.next
  if t.next:
   t.next.prev=t.prev
  else:
   self.tail=t.prev
 def display(self):
  t=self.head
  while t:
   print(t.data,end=" <-> ")
   t=t.next
  print("None")
 def reverse(self):
  t=self.tail
  while t:
   print(t.data,end=" <-> ")
   t=t.prev
  print("None")
d=DLL()
while True:
 print("1.Insert\n2.Delete\n3.Display\n4.Reverse Traversal\n5.Exit")
 ch=int(input("Enter choice: "))
 if ch==1:
  d.insert(int(input("Enter data: ")))
 elif ch==2:
  d.delete(int(input("Enter value to delete: ")))
 elif ch==3:
  d.display()
 elif ch==4:
  d.reverse()
 elif ch==5:
  break
 else:
  print("Invalid choice")
