class Node:
 def __init__(self,data):
  self.data=data
  self.next=None
class SLL:
 def __init__(self):
  self.head=None
 def insert_head(self,data):
  n=Node(data)
  n.next=self.head
  self.head=n
 def insert_tail(self,data):
  n=Node(data)
  if not self.head:
   self.head=n
   return
  t=self.head
  while t.next:
   t=t.next
  t.next=n
 def insert_index(self,data,index):
  if index<0:
   print("Invalid index")
   return
  if index==0:
   self.insert_head(data)
   return
  t=self.head
  for _ in range(index-1):
   if not t:
    print("Invalid index")
    return
   t=t.next
  if not t:
   print("Invalid index")
   return
  n=Node(data)
  n.next=t.next
  t.next=n
 def delete(self,key):
  t=self.head
  if t and t.data==key:
   self.head=t.next
   return
  prev=None
  while t and t.data!=key:
   prev=t
   t=t.next
  if t:
   prev.next=t.next
  else:
   print("Element not found")
 def display(self):
  t=self.head
  while t:
   print(t.data,end=" -> ")
   t=t.next
  print("None")
s=SLL()
