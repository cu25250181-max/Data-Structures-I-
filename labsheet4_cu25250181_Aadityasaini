class Node:
 def __init__(self,data):
  self.data=data
  self.next=None
class Stack:
 def __init__(self):
  self.top=None
 def Push(self,value):
  new_node=Node(value)
  new_node.next=self.top
  self.top=new_node
  print(value,"Pushed into stack")
 def Pop(self):
  if self.top is None:
   print("Stack underflow")
  else:
   value=self.top.data
   self.top=self.top.next
   print(value,"Popped from stack")
 def display(self):
  if self.top is None:
   print("Stack is empty")
  else:
   temp=self.top
   print("Stack elements:")
   while temp is not None:
    print(temp.data)
    temp=temp.next
