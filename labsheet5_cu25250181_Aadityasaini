class IntegerStack:
 def __init__(self):
  self.stack=[]
 def push(self,item):
  self.stack.append(item)
 def pop(self):
  return self.stack.pop()
 def is_empty(self):
  return len(self.stack)==0
def evaluate_postfix(expression):
 stack=IntegerStack()
 for ch in expression:
  if ch.isdigit():
   stack.push(int(ch))
  elif ch in '+-*/':
   b=stack.pop()
   a=stack.pop()
   if ch=='+':
    stack.push(a+b)
   elif ch=='-':
    stack.push(a-b)
   elif ch=='*':
    stack.push(a*b)
   elif ch=='/':
    stack.push(a//b)
 return stack.pop()
postfix="23*4+"
print("Postfix Expression:",postfix)
print("Final Result:",evaluate_postfix(postfix))
