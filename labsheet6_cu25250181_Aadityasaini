class Node:
 def __init__(self,data):
  self.data=data
  self.left=None
  self.right=None
root=Node(1)
root.left=Node(2)
root.right=Node(3)
root.left.left=Node(4)
root.left.right=Node(5)
def display_tree(node,space=0):
 if node is None:
  return
 space+=5
 display_tree(node.right,space)
 print()
 print(" "*space+str(node.data))
 display_tree(node.left,space)
def inorder(node):
 if node:
  inorder(node.left)
  print(node.data,end=" ")
  inorder(node.right)
print("Binary Tree:")
display_tree(root)
print("\nInorder Traversal:")
inorder(root)
print()
