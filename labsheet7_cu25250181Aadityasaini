import heapq
files=[20,30,10,5]
heapq.heapify(files)
total=0
while len(files)>1:
 a=heapq.heappop(files)
 b=heapq.heappop(files)
 merge=a+b
 total+=merge
 print(a,"+",b,"=",merge)
 heapq.heappush(files,merge)
print("Minimum Total Moves:",total)
