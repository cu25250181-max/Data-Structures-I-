def insertion_sort(a):
 for i in range(1,len(a)):
  key=a[i]
  j=i-1
  while j>=0 and a[j]>key:
   a[j+1]=a[j]
   j-=1
  a[j+1]=key
 return a
def bucket_sort(a):
 buckets=[[] for _ in range(len(a))]
 for x in a:
  buckets[int(x*len(a))].append(x)
 for b in buckets:
  b.sort()
 return [x for b in buckets for x in b]
a=[0.42,0.32,0.23,0.52,0.25,0.47,0.51]
