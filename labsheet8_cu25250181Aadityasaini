class Node:
 def __init__(self,data):
  self.data=data
  self.left=None
  self.right=None
def insert(root,data):
 if root is None:
  return Node(data)
 if data<root.data:
  root.left=insert(root.left,data)
 elif data>root.data:
  root.right=insert(root.right,data)
 return root
def delete(root,data):
 if root is None:
  return root
 if data<root.data:
  root.left=delete(root.left,data)
 elif data>root.data:
  root.right=delete(root.right,data)
 else:
  if root.left is None:
   return root.right
  if root.right is None:
   return root.left
  temp=root.right
  while temp.left:
   temp=temp.left
  root.data=temp.data
  root.right=delete(root.right,temp.data)
 return root
def inorder(root):
 if root:
  inorder(root.left)
  print(root.data,end=" ")
  inorder(root.right)
root=None
for value in [50,30,70,20,40,60,80]:
 root=insert(root,value)
print("BST before deletion:")
inorder(root)
root=delete(root,50)
print("\nBST after deletion:")
inorder(root)
