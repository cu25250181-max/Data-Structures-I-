import time
def linear_search(arr,key):
 for i in range(len(arr)):
  if arr[i]==key:
   return i
 return -1
def binary_search(arr,key):
 low=0
 high=len(arr)-1
 while low<=high:
  mid=(low+high)//2
  if arr[mid]==key:
   return mid
  elif arr[mid]<key:
   low=mid+1
  else:
   high=mid-1
 return -1
arr=list(range(1,100001))
key=99999
start=time.perf_counter()
print("Linear Search Index:",linear_search(arr,key))
print("Linear Search Time:",time.perf_counter()-start)
start=time.perf_counter()
print("Binary Search Index:",binary_search(arr,key))
print("Binary Search Time:",time.perf_counter()-start)
